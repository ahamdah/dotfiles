{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "complex_modifications": {
        "rules": [
          {
            "description": "Keep arrow keys working in the Cmd+Tab app switcher (skip the Cmd+Arrow remaps while it is open)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "cmd_tab_switcher",
                      "value": 1
                    }
                  },
                  {
                    "key_code": "tab",
                    "modifiers": [
                      "command"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "left_command",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_command"
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "cmd_tab_switcher",
                      "value": 0
                    }
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "right_command",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "right_command"
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "cmd_tab_switcher",
                      "value": 0
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Cmd+Left/Right moves by word (Shift+Cmd selects by word), like Ctrl+Arrow on Windows",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "left_arrow",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_arrow",
                    "modifiers": [
                      "option"
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "cmd_tab_switcher",
                    "value": 1
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "right_arrow",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "right_arrow",
                    "modifiers": [
                      "option"
                    ]
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "cmd_tab_switcher",
                    "value": 1
                  }
                ]
              }
            ]
          },
          {
            "description": "Cmd+Delete deletes the previous word, Cmd+Fn+Delete the next one (Ctrl+W / Esc d in terminals)",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^dev\\.warp\\.Warp-Stable$"
                    ]
                  }
                ],
                "from": {
                  "key_code": "delete_or_backspace",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "w",
                    "modifiers": [
                      "control"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^dev\\.warp\\.Warp-Stable$"
                    ]
                  }
                ],
                "from": {
                  "key_code": "delete_forward",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "escape"
                  },
                  {
                    "key_code": "d"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "delete_or_backspace",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "delete_or_backspace",
                    "modifiers": [
                      "option"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "delete_forward",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "delete_forward",
                    "modifiers": [
                      "option"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Cmd+Up/Down jumps by paragraph (Shift+Cmd selects), like Ctrl+Up/Down on Windows; not in terminals or VS Code (see vscode/keybindings.json)",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^dev\\.warp\\.Warp-Stable$",
                      "^com\\.microsoft\\.VSCode$"
                    ]
                  },
                  {
                    "type": "variable_unless",
                    "name": "cmd_tab_switcher",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "up_arrow",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "up_arrow",
                    "modifiers": [
                      "option"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^dev\\.warp\\.Warp-Stable$",
                      "^com\\.microsoft\\.VSCode$"
                    ]
                  },
                  {
                    "type": "variable_unless",
                    "name": "cmd_tab_switcher",
                    "value": 1
                  }
                ],
                "from": {
                  "key_code": "down_arrow",
                  "modifiers": {
                    "mandatory": [
                      "command"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "down_arrow",
                    "modifiers": [
                      "option"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      }
    }
  ]
}
